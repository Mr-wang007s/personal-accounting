<!--首页 - 渐进式加载优化-->
<view class="page-container">
  <!-- 错误状态 -->
  <view class="error-state" wx:if="{{hasError}}">
    <image class="error-icon" src="/assets/icons/alert-circle.png" mode="aspectFit"></image>
    <text class="error-text">加载失败</text>
    <button class="retry-btn" bindtap="retryLoad">重试</button>
  </view>

  <!-- 正常内容（始终渲染，通过动画显示） -->
  <block wx:else>
    <!-- 头部卡片 -->
    <view class="header-card {{contentReady ? 'content-visible' : ''}}">
      <!-- 刷新指示器 -->
      <view class="refresh-indicator {{isRefreshing ? 'visible' : ''}}">
        <view class="mini-spinner"></view>
      </view>
      
      <view class="header-top">
        <!-- 账本信息：骨架屏或真实内容 -->
        <view class="ledger-info" bindtap="switchLedger" wx:if="{{!isInitializing && currentLedger}}">
          <text class="ledger-icon">{{currentLedger.icon || '📒'}}</text>
          <text class="ledger-name">{{currentLedger.name || '默认账本'}}</text>
          <image class="arrow-icon" src="/assets/icons/chevron-down.png" mode="aspectFit"></image>
        </view>
        <view class="ledger-info skeleton" wx:else>
          <view class="skeleton-text" style="width: 120rpx;"></view>
        </view>
        
        <text class="month-label">{{currentMonth}}月</text>
      </view>
      
      <view class="balance-section">
        <text class="balance-label">本月结余</text>
        <view class="balance-amount">
          <text class="currency">¥</text>
          <!-- 金额：骨架屏或真实数字 -->
          <text class="amount {{balance >= 0 ? 'positive' : 'negative'}}" wx:if="{{!isInitializing}}">{{balanceDisplay}}</text>
          <view class="skeleton-amount" wx:else></view>
        </view>
      </view>
      
      <view class="summary-row">
        <view class="summary-item">
          <text class="summary-label">收入</text>
          <text class="summary-value income" wx:if="{{!isInitializing}}">+{{incomeDisplay}}</text>
          <view class="skeleton-text small" wx:else></view>
        </view>
        <view class="summary-divider"></view>
        <view class="summary-item">
          <text class="summary-label">支出</text>
          <text class="summary-value expense" wx:if="{{!isInitializing}}">-{{expenseDisplay}}</text>
          <view class="skeleton-text small" wx:else></view>
        </view>
      </view>
    </view>
    
    <!-- 快捷操作 -->
    <view class="quick-actions {{contentReady ? 'content-visible' : ''}}">
      <view class="action-btn income-btn" bindtap="goToRecordIncome">
        <view class="action-icon income-icon">
          <image src="/assets/icons/plus.png" mode="aspectFit"></image>
        </view>
        <text class="action-text">记收入</text>
      </view>
      <view class="action-btn expense-btn" bindtap="goToRecordExpense">
        <view class="action-icon expense-icon">
          <image src="/assets/icons/minus.png" mode="aspectFit"></image>
        </view>
        <text class="action-text">记支出</text>
      </view>
    </view>
    
    <!-- 最近记录 -->
    <view class="recent-section {{contentReady ? 'content-visible' : ''}}">
      <view class="section-header">
        <text class="section-title">最近记录</text>
        <view class="view-all" bindtap="goToRecords">
          <text>查看全部</text>
          <image src="/assets/icons/chevron-right.png" mode="aspectFit"></image>
        </view>
      </view>
      
      <!-- 骨架屏列表 -->
      <view class="records-list" wx:if="{{isInitializing}}">
        <view class="record-item skeleton-item" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="record-icon skeleton-icon"></view>
          <view class="record-info">
            <view class="skeleton-text" style="width: 120rpx; margin-bottom: 12rpx;"></view>
            <view class="skeleton-text small" style="width: 80rpx;"></view>
          </view>
          <view class="skeleton-text" style="width: 100rpx;"></view>
        </view>
      </view>
      
      <!-- 真实记录列表 -->
      <view class="records-list" wx:elif="{{recentRecords.length > 0}}">
        <view 
          class="record-item {{contentReady ? 'item-visible' : ''}}" 
          wx:for="{{recentRecords}}" 
          wx:key="id" 
          bindtap="editRecord" 
          data-id="{{item.id}}"
          style="animation-delay: {{index * 50}}ms;"
        >
          <view class="record-icon {{item.type}}">
            <image src="/assets/icons/category/{{item.categoryIcon}}.png" mode="aspectFit"></image>
          </view>
          <view class="record-info">
            <text class="record-category">{{item.categoryName}}</text>
            <text class="record-note" wx:if="{{item.note}}">{{item.note}}</text>
            <text class="record-date">{{item.dateLabel}}</text>
          </view>
          <text class="record-amount {{item.type}}">{{item.type === 'income' ? '+' : '-'}}{{item.amountDisplay}}</text>
        </view>
      </view>
      
      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <image src="/assets/icons/empty.png" mode="aspectFit"></image>
        <text>暂无记录，开始记账吧</text>
      </view>
    </view>
  </block>
</view>
