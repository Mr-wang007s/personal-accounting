<!--首次使用引导页 - 手机号登录-->
<view class="page-container">
  <view class="content">
    <!-- Logo 和标题 -->
    <view class="header">
      <view class="logo">
        <text class="logo-icon">💰</text>
      </view>
      <text class="title">个人记账</text>
      <text class="subtitle">简单记录，轻松理财</text>
    </view>
    
    <!-- 登录卡片 -->
    <view class="login-card">
      <text class="card-title">手机号登录</text>
      
      <!-- 手机号输入 -->
      <view class="input-group">
        <text class="input-label">手机号</text>
        <view class="input-wrapper">
          <text class="input-icon">📱</text>
          <input 
            type="number"
            class="phone-input" 
            placeholder="请输入手机号" 
            value="{{phone}}"
            bindinput="onPhoneInput"
            maxlength="11"
          />
        </view>
      </view>
      
      <!-- 错误提示 -->
      <view class="error-tip" wx:if="{{errorMsg}}">
        <text>{{errorMsg}}</text>
      </view>
      
      <!-- 登录按钮 -->
      <button 
        class="login-btn {{!phone || phone.length !== 11 ? 'disabled' : ''}}" 
        bindtap="handleLogin" 
        disabled="{{!phone || phone.length !== 11 || isLoading}}"
      >
        {{isLoading ? '登录中...' : '开始记账'}}
      </button>
      
      <!-- 提示信息 -->
      <text class="hint">首次登录将自动创建账户</text>
    </view>
    
    <!-- 底部信息 -->
    <text class="footer">数据安全加密存储</text>
  </view>
</view>
