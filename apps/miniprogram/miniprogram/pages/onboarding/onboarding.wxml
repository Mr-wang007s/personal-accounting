<!--首次使用引导页 - 邮箱验证码登录-->
<view class="page-container">
  <view class="content">
    <!-- Logo 和标题 -->
    <view class="header">
      <view class="logo">
        <text class="logo-icon">💰</text>
      </view>
      <text class="title">个人记账</text>
      <text class="subtitle">简单记录，轻松理财</text>
    </view>
    
    <!-- 登录卡片 -->
    <view class="login-card">
      <text class="card-title">邮箱登录</text>
      
      <!-- 邮箱输入 -->
      <view class="input-group">
        <text class="input-label">邮箱地址</text>
        <view class="input-wrapper">
          <text class="input-icon">📧</text>
          <input 
            type="text"
            class="email-input" 
            placeholder="请输入邮箱地址" 
            value="{{email}}"
            bindinput="onEmailInput"
          />
        </view>
      </view>
      
      <!-- 验证码输入 -->
      <view class="input-group">
        <text class="input-label">验证码</text>
        <view class="input-wrapper code-wrapper">
          <text class="input-icon">🔐</text>
          <input 
            type="number"
            class="code-input" 
            placeholder="请输入验证码" 
            value="{{code}}"
            bindinput="onCodeInput"
            maxlength="6"
          />
          <button 
            class="send-code-btn {{!canSendCode ? 'disabled' : ''}}"
            disabled="{{!canSendCode || isSendingCode}}"
            bindtap="handleSendCode"
          >
            {{isSendingCode ? '发送中...' : (countdown > 0 ? countdown + 's后重发' : '获取验证码')}}
          </button>
        </view>
      </view>
      
      <!-- 成功提示 -->
      <view class="success-tip" wx:if="{{successMsg}}">
        <text>{{successMsg}}</text>
      </view>
      
      <!-- 错误提示 -->
      <view class="error-tip" wx:if="{{errorMsg}}">
        <text>{{errorMsg}}</text>
      </view>
      
      <!-- 登录按钮 -->
      <button 
        class="login-btn {{!canLogin ? 'disabled' : ''}}" 
        bindtap="handleLogin" 
        disabled="{{!canLogin || isLoading}}"
      >
        {{isLoading ? '登录中...' : '开始记账'}}
      </button>
      
      <!-- 提示信息 -->
      <text class="hint">首次登录将自动创建账户</text>
    </view>
    
    <!-- 底部信息 -->
    <text class="footer">数据安全加密存储</text>
  </view>
</view>
