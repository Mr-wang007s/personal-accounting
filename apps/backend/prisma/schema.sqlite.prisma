// Prisma Schema for Personal Accounting App - SQLite 本地开发版本
// 注意：此 schema 需与 packages/shared/src/types/index.ts 保持同步

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// 用户认证系统（支持多种登录方式）
// ============================================

// 用户表 - 核心用户信息
model User {
  id        String   @id @default(cuid())
  nickname  String?  // 昵称
  avatar    String?  // 头像 URL
  status    String   @default("active") // 用户状态: active/inactive/banned
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联
  auths    UserAuth[]  // 登录凭证（一对多）
  records  Record[]
  ledgers  Ledger[]

  @@map("users")
}

// 用户认证凭证表 - 支持多种登录方式
model UserAuth {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  authType   String   // 认证类型: email/phone/wechat/google/github/apple/username
  identifier String   // 唯一标识（邮箱/手机号/第三方openid）
  credential String?  // 凭证（密码hash/access_token等，可选）
  
  // 第三方登录额外信息
  provider   String?  // 第三方提供商（wechat/google/github/apple）
  unionid    String?  // 微信 unionid（用于关联多个微信应用）
  
  verified   Boolean  @default(false) // 是否已验证
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // 同一认证类型下标识唯一
  @@unique([authType, identifier])
  @@index([userId])
  @@index([provider, identifier])
  @@map("user_auths")
}

// ============================================
// 业务数据
// ============================================

// 账本表 - 对应 shared/types Ledger 接口
model Ledger {
  id        String    @id @default(cuid())
  name      String
  icon      String?
  color     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // 软删除

  // 客户端 ID（用于备份/恢复时匹配）
  clientId String? @map("client_id")

  // 关联 - 使用 userId 作为外键
  userId  String   @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  records Record[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@map("ledgers")
}

// 记账记录表 - 对应 shared/types Record 接口
model Record {
  id        String    @id @default(cuid())
  type      String    // income/expense
  amount    Decimal
  category  String
  date      DateTime
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // 软删除

  // 客户端 ID（用于备份/恢复时匹配本地记录）
  clientId String? @map("client_id")

  // 关联 - 使用 userId 作为外键
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerId String @map("ledger_id") // 所属账本（必填）
  ledger   Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, deletedAt])
  @@index([userId, clientId]) // 用于备份时按 clientId 查找
  @@index([ledgerId])
  @@map("records")
}
